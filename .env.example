# Application
APP_NAME=Local Web App Template
APP_PORT=8000
APP_DATA_DIR=data
LOG_LEVEL=INFO

# Direct localhost access. Change these for your own machine.
# Tailscale Serve users are identified from Tailscale headers instead.
LOCAL_OWNER_EMAIL=local-owner@example.invalid
LOCAL_OWNER_NAME=Local Owner

# Keep false unless you intentionally want unauthenticated access on localhost.
ALLOW_ANONYMOUS=false
